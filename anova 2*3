# Clean DataFrame from NaNs in relevant columns for PeakMagnitude ANOVA
df_mag_clean = df_clean.dropna(subset=['PeakMagnitude', 'Perception', 'NoiseLevel']).copy()

if df_mag_clean.empty:
    print("Error: DataFrame for PeakMagnitude ANOVA is empty after dropping rows with NaNs. Cannot perform ANOVA.")
else:
    model_mag = ols('PeakMagnitude ~ C(Perception) * C(NoiseLevel)', data=df_mag_clean).fit()
    print(sm.stats.anova_lm(model_mag, typ=2))

