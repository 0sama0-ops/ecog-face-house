import numpy as np
import matplotlib.pyplot as plt
from scipy import signal

# ۱. بارگذاری داده‌های dat1 برای سوژه ۱
# (فرض بر این است که فایل faceshouses.npz بارگذاری شده است)
alldat = np.load('faceshouses.npz', allow_pickle=True)['dat']
dat1 = alldat[1][0]

V = dat1['V'].astype('float32')   # ولتاژ خام (Time x Channels)
t_on = dat1['t_on']               # زمان شروع محرک‌ها
stim_id = dat1['stim_id']         # شناسه محرک‌ها
srate = dat1['srate'].item()      # ۱۰۰۰ هرتز, converted to scalar
target_ch = 46                    # کانال حساس به چهره

# ==========================================
# A. محاسبه Broadband Power (روش میلر / NMA)
# ==========================================
# ۱. فیلتر بالاگذر ۵۰ هرتز
b_hp, a_hp = signal.butter(3, [50], btype='high', fs=srate)
V_bb_filt = signal.filtfilt(b_hp, a_hp, V[:, target_ch])
# ۲. توان و فیلتر پایین‌گذر ۱۰ هرتز برای Envelope
V_bb_pow = np.abs(V_bb_filt)**2
b_lp, a_lp = signal.butter(3, [10], btype='low', fs=srate)
bb_envelope = signal.filtfilt(b_lp, a_lp, V_bb_pow)
bb_envelope = bb_envelope / bb_envelope.mean()  # نرمال‌سازی

# ==========================================
# B. محاسبه High-Gamma Power (۷۰ تا ۱۵۰ هرتز با هیلبرت)
# ==========================================
# ۱. فیلتر میان‌گذر ۷۰ تا ۱۵۰ هرتز
b_hg, a_hg = signal.butter(4, [70, 150], btype='bandpass', fs=srate)
V_hg_filt = signal.filtfilt(b_hg, a_hg, V[:, target_ch])
# ۲. حذف هارمونیک برق شهر (۱۲۰ هرتز) در صورت نیاز
b_notch, a_notch = signal.iirnotch(w0=120, Q=30, fs=srate)
V_hg_filt = signal.filtfilt(b_notch, a_notch, V_hg_filt)
# ۳. دامنه لحظه‌ای با تبدیل هیلبرت (Hilbert Envelope)
hg_analytic = signal.hilbert(V_hg_filt)
hg_envelope = np.abs(hg_analytic)**2
hg_envelope = hg_envelope / hg_envelope.mean()  # نرمال‌سازی

# ==========================================
# C. قطعه‌بندی (Epoching) برای هر دو سیگنال
# ==========================================
trange = np.arange(-200, 400)
ts = t_on[:, np.newaxis] + trange

bb_epochs = bb_envelope[ts]  # (n_trials, 600)
hg_epochs = hg_envelope[ts]  # (n_trials, 600)

# تفکیک ترايال‌های Face و House
is_face = stim_id > 50
is_house = stim_id <= 50

# ==========================================
# D. رسم رستر پلات و میانگین مقایسه‌ای
# ==========================================
fig, axes = plt.subplots(2, 2, figsize=(15, 8), sharex=True)

# 1. Raster Plot: Broadband (Face vs House)
isort = np.argsort(stim_id)
im1 = axes[0, 0].imshow(bb_epochs[isort], aspect='auto', extent=[-200, 400, 100, 1], cmap='magma', vmax=6)
axes[0, 0].set_title(f'Broadband Power Raster (Ch {target_ch})')
axes[0, 0].set_ylabel('Sorted Trials (1-50 House, 51-100 Face)')
axes[0, 0].axvline(x=0, color='w', linestyle='--')
axes[0, 0].axhline(y=50.5, color='cyan', linestyle='--')
fig.colorbar(im1, ax=axes[0, 0])

# 2. Raster Plot: High-Gamma (Face vs House)
im2 = axes[0, 1].imshow(hg_epochs[isort], aspect='auto', extent=[-200, 400, 100, 1], cmap='viridis', vmax=6)
axes[0, 1].set_title(f'High-Gamma (70-150Hz) Raster (Ch {target_ch})')
axes[0, 1].set_ylabel('Sorted Trials')
axes[0, 1].axvline(x=0, color='w', linestyle='--')
axes[0, 1].axhline(y=50.5, color='cyan', linestyle='--')
fig.colorbar(im2, ax=axes[0, 1])

# 3. Average Response: Broadband
axes[1, 0].plot(trange, bb_epochs[is_face].mean(0), 'r', label='Face', lw=2)
axes[1, 0].plot(trange, bb_epochs[is_house].mean(0), 'b', label='House', lw=2)
axes[1, 0].set_title('Averaged Broadband Power')
axes[1, 0].set_xlabel('Time (ms)')
axes[1, 0].set_ylabel('Normalized Power')
axes[1, 0].legend()
axes[1, 0].axvline(x=0, color='k', linestyle='--')

# 4. Average Response: High-Gamma
axes[1, 1].plot(trange, hg_epochs[is_face].mean(0), 'r', label='Face', lw=2)
axes[1, 1].plot(trange, hg_epochs[is_house].mean(0), 'b', label='House', lw=2)
axes[1, 1].set_title('Averaged High-Gamma Power')
axes[1, 1].set_xlabel('Time (ms)')
axes[1, 1].set_ylabel('Normalized Power')
axes[1, 1].legend()
axes[1, 1].axvline(x=0, color='k', linestyle='--')

plt.tight_layout()
plt.show()
